# ==============================================================================
# Handicrafts Association of Bhutan (HAB) — Production Environment Configuration
# Save as .env on your VPS inside the project directory (/www/wwwroot/hab-bhutan)
# ==============================================================================

# 1. PostgreSQL Database Connection (matches aaPanel Database setup)
DATABASE_URL="postgresql://hab_production:hab_production@127.0.0.1:5432/hab_production?schema=public"

# 2. JWT Signing Secret (Minimum 32 characters, high entropy)
# Generate on VPS with: openssl rand -hex 32
JWT_SECRET="REPLACE_WITH_HIGH_ENTROPY_64_CHAR_HEX_KEY"

# 3. Environment & Port
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"

# 4. Out-of-Band Initial Administrator Credential (Used for seed / initial setup)
ADMIN_INITIAL_PASSWORD="REPLACE_WITH_STRONG_GENERATED_PASSWORD"

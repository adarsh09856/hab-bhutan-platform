# ==============================================================================
# Handicrafts Association of Bhutan (HAB) — Environment Configuration Template
# ==============================================================================

# PostgreSQL Database Connection String
# For local development with PostgreSQL running locally on port 5432:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hab_platform?schema=public"
# For production managed databases (Supabase / Neon / AWS RDS):
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Session Signing Secret
# SECURITY REQUIREMENT: Generate a cryptographically secure random string with minimum 64 characters.
# Command to generate: openssl rand -base64 48
# In production, the application will refuse to boot if JWT_SECRET is unset.
JWT_SECRET="hab-bhutan-platform-secure-secret-key-2026-replace-with-64-character-random-entropy"

# Node Environment
NODE_ENV="development"

# Port (optional, defaults to 3000)
PORT=3000
